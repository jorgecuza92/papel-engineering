#__Play/Pause Icons
%V(139,50,42,22,-)
%?mp<%xd(T)|%xd(L)|%xd(Z)|%xd(F)|%xd(R)>
#
#__Battery Bar
%V(143,84,30,15,-)%Vf(000000)
%bl(0,0,30,15)
%V(173,88,2,7,-)%Vf(000000)
%dr(0,0,2,7)
#
#__Hold
%V(20,113,38,14,-)%Vf(000000)
%ac%?mh<hold|---->
