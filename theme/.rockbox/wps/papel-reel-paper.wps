#
#__OP_1
#__by__CHUCK_LARDO
#__licence__CC-BY-SA 4.0 (this adaptation is CC-BY-SA 4.0 as well)
#__papél reel (off-white): OP_1 by CHUCK_LARDO, recoloured to the papél paper palette (black reels on #f7efef, orange signal).
#__needs the papél firmware (25 fps timers %t(0.04), %ss case flags): github.com/jorgecuza92/papel
#__adaptation c/o Jorge Cuza: github.com/jorgecuza92/papel-engineering
#__target resolution 320x240 (iPod Video)
#
%wd
#
#
#__Load Backdrop
%X(OP_backdrop.bmp)
#
#__Preload Fonts
%Fl(2,20-Courier-Prime-Papel.fnt)
%Fl(3,22-Courier-Prime-Papel-Bold.fnt)
%Fl(4,32-Courier-Prime-Papel.fnt)
%Fl(5,20-Courier-Prime-Papel-Bold.fnt)

#
#__Preload Images
%xl(E,reel.bmp,0,0,60)
%xl(Q,reel_m.bmp,0,0,60)
%xl(W,reel_f.bmp,0,0,60)
%xl(T,stop_icon.bmp,0,0)
%xl(L,play_icon.bmp,0,0)
%xl(Z,pause_icon.bmp,0,0)
%xl(F,forward_icon.bmp,0,0)
%xl(R,rewind_icon.bmp,0,0)
%xl(PBB,pb_back.bmp,0,0)
%xl(PB,pb.bmp,0,0)
%xl(M,mark.bmp,0,0)
#
#
#__Viewport Start
#
#__Hidden peak meter tag: makes Rockbox redraw this screen 25x/sec (custom build) instead of 5x (smooth reels)
%V(0,0,1,1,-)
%?pL<|>
#
#__Track Number
%V(20,5,30,32,4)%Vf(000000)
%pp
#
#__Time Elapsed
%V(120,20,80,20,5)%Vf(000000)
%ac%pc
#
#__Logo (replaces the shuffle/repeat "0_0" indicator)
%V(268,16,32,20,-)
%xd(M)
#
